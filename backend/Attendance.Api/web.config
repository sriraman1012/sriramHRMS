<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom web.config kept in the project so `dotnet publish` preserves it.
  The key part is removing IIS WebDAV, which otherwise intercepts DELETE / PUT
  requests and returns 405 (Method Not Allowed) before they reach the API.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Attendance.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
